# Copy this file to .env and fill in real values before running `npm run deploy`.
# Get these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# (storageBucket isn't used by this build — Cloud Storage now requires the
# paid Blaze plan even to create a bucket, so this build doesn't use Storage
# at all. Leave FIREBASE_STORAGE_BUCKET blank, or fill it in anyway if
# Firebase already generated one — it's harmless either way.)

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Get this from: https://aistudio.google.com/apikey
# IMPORTANT: unlike the original Cloud-Functions build, this key is written
# directly into public/ordinex.html and shipped to every visitor's browser
# — there is no server left to hide it behind on the free plan. Restrict it
# before you deploy: Google AI Studio -> your key -> "Set an application
# restriction" -> HTTP referrers -> add your *.web.app / *.firebaseapp.com
# domain(s). See SETUP.md for the full explanation.
GEMINI_API_KEY=
